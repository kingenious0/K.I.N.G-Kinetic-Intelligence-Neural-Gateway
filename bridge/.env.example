# K.I.N.G. bridge environment
# ===================================================================
# Copy this to bridge/.env — which is gitignored, and this file is not.
#
#   cp bridge/.env.example bridge/.env
#
# bridge/server.mjs reads bridge/.env at start-up via bridge/envfile.mjs, so
# these work on every platform. A real environment variable always beats a line
# here, so CI and ad-hoc overrides still win.
#
# This is a SEPARATE file from the project root's .env.local. That one belongs
# to Vite and names its variables VITE_*; this one belongs to the Node bridge
# and never uses a VITE_ prefix. Keeping them apart is what stops a browser
# bundle from picking up a database connection string.
#
# Never give any line below a VITE_ or GROQ_ prefix. Those are the two prefixes
# Vite copies into the page, and a token in a static file is a token anyone can
# read.


# ===================================================================
# PERMISSIONS
# ===================================================================

# The tool gate. Off means K.I.N.G. can look at anything and change nothing;
# on means the effectful tools exist (king_clone, king_deploy, sends, deletes).
# Read decideTool() in bridge/server.mjs before changing it — "clone the
# monorepo into my workspace" means something rather different once this is on.
#
# On Windows, set this here rather than with `npm run bridge:writes`: an inline
# `VAR=1 command` prefix is a shell feature that cmd does not implement, so the
# npm script silently fails instead of enabling writes.
JARVIS_ALLOW_WRITES=0


# ===================================================================
# TOKENS — all optional, all bridge-only
# ===================================================================

# GitHub. Used by king_deploy's target "github" (workflow dispatch). Read-only
# GitHub tools go through the machine's own `gh` login instead, so leave this
# blank if you have run `gh auth login`.
#
# The bridge also reads this from ~/.claude.json under
# mcpServers.github.env.GITHUB_PERSONAL_ACCESS_TOKEN, so a key that is already
# there needs no entry here. The environment wins when both are set.
# Scope: repo + workflow. No `VITE_` prefix, ever.
GITHUB_PERSONAL_ACCESS_TOKEN=

# Postgres / Supabase connection string. The first one that is set wins:
#   SUPABASE_SESSION_DB_URL      session pooler, port 5432
#   SUPABASE_TRANSACTION_DB_URL  transaction pooler, port 6543
#   DATABASE_URL                 the generic name everything else uses
# Leave all three empty and no `postgres` tool is advertised at all — a tool
# that can only fail is worse than no tool. Also accepted from ~/.claude.json
# as an mcpServers.postgres entry when no environment variable is set.
DATABASE_URL=

# Vercel, for king_deploy's target "vercel". Reports the deployment id it got
# back, or refuses with no token configured.
VERCEL_TOKEN=

# ElevenLabs. With it, K.I.N.G. speaks in the ElevenLabs voice and transcribes
# with ElevenLabs Scribe; without it, both fall back to the browser's own
# speech. Also read from ~/.claude.json under
# mcpServers.elevenlabs.env.ELEVENLABS_API_KEY — see the README.
ELEVENLABS_API_KEY=

# The ElevenLabs voice used by the bridge's own speech endpoint.
JARVIS_VOICE_ID=JBFqnCBsd6RMkjVDRZzb


# ===================================================================
# ALSO READ FROM THE ENVIRONMENT (defaults are fine)
# ===================================================================
# JARVIS_BRIDGE_PORT=8787
# JARVIS_MODEL=claude-opus-5
# JARVIS_EFFORT=medium
# JARVIS_ALLOWED_ORIGINS=
# JARVIS_ALLOW_NO_ORIGIN=0
# JARVIS_FILE_ROOTS=
# JARVIS_DEBUG=0
#
# # Writes only — king_clone and king_deploy. Defaults shown.
# KING_WORKSPACE=
# AAPANEL_URL=
# AAPANEL_KEY=
